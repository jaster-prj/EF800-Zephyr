menu "EF800 isolation fault-injection spike"

config EF800_SPIKE_FAULT_MODE
	int "User-worker fault to inject"
	range 0 16
	default 0
	help
	  Select one isolated worker fault for the dedicated MPU validation image:
	  0 runs the normal access test, 1 reads protected host RAM, 2 writes
	  protected host RAM, 3 executes from RW/XN data, 4 executes UDF, 5 writes
	  directly to the worker's MPU stack guard, 6 overflows the worker stack,
	  7 starts the USB-CDC plugin lifecycle test console, 8 faults in privileged
	  thread context, 9 faults in an ISR, 10 faults again while classifying a
	  worker fault, 11 faults in the user worker outside the plugin image,
	  12 writes RO constants, 13 executes from the RW mailbox, 14 reads a kernel
	  object, 15 reads MMIO, and 16 reads an unmapped plugin-sized buffer.

config EF800_SPIKE_USB_CDC_TEST
	bool
	default y if BOARD_NUCLEO_WB55RG && EF800_SPIKE_FAULT_MODE = 7
	select COMMON_LIBC_MALLOC
	select COMMON_LIBC_CALLOC
	select USB_DEVICE_STACK_NEXT
	select USBD_CDC_ACM_CLASS
	select UART_LINE_CTRL
	help
	  Enable the temporary WB55 USER_USB CDC ACM host/test interface.

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 65536 if EF800_SPIKE_USB_CDC_TEST

endmenu

source "Kconfig.zephyr"
