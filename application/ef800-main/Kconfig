menu "EF800 MainApplication foundation"

config EF800_MAIN_PLUGIN_DEV_DIRECT_EXECUTION
	bool "Allow trusted development plugins to execute inline"
	default n
	help
	  Keep the legacy inline callback executor available for native_sim and
	  explicitly trusted development packages. This is not an isolation mode.
	  Production external package execution must remain disabled until the
	  unprivileged worker and mediated service gateway are enabled and qualified.

config EF800_MAIN_PLUGIN_WORKER_STACK_SIZE
	int "Plugin worker stack size"
	default 2048
	range 1024 8192
	depends on USERSPACE || BOARD_NATIVE_SIM
	help
	  Stack allocation for the single serialized external-plugin worker. The
	  physical EF800 worker receives MPU protection; native_sim uses this same
	  worker ABI without hardware-enforced memory isolation.

config EF800_MAIN_PLUGIN_USER_WORKER
	bool "Run external plugins on the worker ABI"
	default y if BOARD_NATIVE_SIM
	default n
	depends on ((BOARD_EF800 && USERSPACE) || BOARD_NATIVE_SIM) && \
		!EF800_MAIN_PLUGIN_DEV_DIRECT_EXECUTION
	help
	  Execute external plugin callbacks through the versioned worker ABI and
	  mediated host services. EF800 additionally runs the worker unprivileged
	  with MPU-constrained memory; native_sim emulates the worker protocol but
	  does not provide MPU isolation. This is not package-authenticity or release
	  qualification.

config EF800_MAIN_SRAM_TEST_FAIL
	bool "Force external SRAM validation failure for fallback testing"
	default n
	depends on BOARD_EF800
	help
	  Test-only fault injection. Forces the startup validator to reject external
	  SRAM so the internal-only startup path can be exercised on target. Never
	  enable in a product image.

config EF800_MAIN_FORCE_CONSOLE_FALLBACK
	bool "Force fallback console during assignment repair testing"
	default n
	depends on BOARD_EF800
	help
	  Test-only recovery option. Keeps the console on its configured fallback
	  UART while persisted port assignments are repaired. Never enable in a
	  product image.

config EF800_MAIN_PLUGIN_RECOVERY_TEST_DIRECTORY
	bool "Scan the recovery-test package directory in Shared Data"
	default n
	depends on EF800_MAIN_PLUGIN_USER_WORKER
	help
	  Test-only override that scans /DATA:/data/EF800-recovery-test instead of
	  the normal Plugins directory. Use only with a dedicated recovery-test
	  image and synthetic packages; never enable in a product build.

config EF800_MAIN_PROBE_FUEL_GAUGE_AT_STARTUP
	bool "Probe MAX17048 once from runtime battery sampling"
	default y
	help
		Perform one deferred fuel-gauge probe from the runtime battery worker
		after MainApplication initialization. A missing gauge is left unavailable
		until restart; it is not retried during the current boot. Disable this
		when the target has no supported fuel-gauge source.

config EF800_MAIN_STORAGE_FORMAT_ON_MOUNT_FAILURE
	bool "Format the QSPI storage after a mount failure"
	default n

config EF800_MAIN_KEYBOARD_STARTUP_TIMEOUT_MS
	int "Keyboard startup timeout (ms)"
	default 3000
	range 1 60000
	help
	  Maximum time the MainApplication waits for the keyboard's initialized
	  indication before continuing with the rest of the foundation.

config EF800_MAIN_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	default 1000
	range 1 26214
	help
	  Maximum watchdog window used by the foundation watchdog task.

config EF800_MAIN_WATCHDOG_FEED_MS
	int "Watchdog feed period (ms)"
	default 100
	range 1 26214
	help
	  Period between watchdog feeds. Keep this below the watchdog timeout.

config EF800_MAIN_WATCHDOG_STACK_SIZE
	int "Watchdog task stack size"
	default 768
	range 512 4096

config EF800_USB_VID
	hex "MainApplication USB vendor ID"
	default 0x2fe3

config EF800_USB_PID
	hex "MainApplication USB product ID"
	default 0xef81

config EF800_MAIN_LCD_STATUS_TIMEOUT_US
	int "T6963 status polling timeout (us)"
	default 1000
	range 100 100000
	help
	  Maximum time spent polling the T6963 ready bits for one bus operation.
	  A bounded timeout keeps a missing or disconnected LCD from blocking the
	  MainApplication forever.

config EF800_MAIN_RUNTIME_RTC_PERIOD_MS
	int "Runtime RTC sample period (ms)"
	default 1000
	range 100 60000

config EF800_MAIN_RUNTIME_BATTERY_PERIOD_MS
	int "Runtime battery sample period (ms)"
	default 10000
	range 1000 600000

config EF800_MAIN_STORAGE_FORMAT_ON_MOUNT_FAILURE
	bool "Format storage after mount failure"
	default n
	help
	  Format and retry the EF800 FAT volume when the initial mount fails.
	  Keep disabled for physical targets so a mount failure never formats a
	  fitted volume. Native simulation may enable this for disposable storage.

config EF800_MAIN_REFORMAT_LEGACY_QSPI
	bool "Reformat a detected legacy QSPI layout"
	default n
	help
	  If the QSPI sector-zero signature identifies the prior monolithic FAT
	  layout, format the new Configuration and Shared Data FAT partitions and
	  initialize the boot-state NVS partition. This destroys all contents of
	  the old volume. Enable only on development targets known to contain no
	  required data; keep disabled for production firmware.

config EF800_MAIN_FORMAT_BLANK_QSPI
	bool "Provision FAT volumes on an erased QSPI device"
	default n
	depends on FS_FATFS_MKFS
	help
	  On development hardware only, create the Configuration and Shared Data
	  FAT volumes when neither FAT partition contains a valid boot sector. The
	  formatter verifies both raw boot sectors before erasing boot-state NVS or
	  allowing normal mounts. This destroys unrecognized contents; disable for
	  production firmware.

config EF800_MCUMGR_SERIAL_TRANSPORT
	bool
	default y
	select MCUMGR_TRANSPORT_SERIAL_HAS_RAW_BINARY_NON_SMP_OVER_CONSOLE

endmenu

source "Kconfig.zephyr"
