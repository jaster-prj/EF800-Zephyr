/ {
	chosen {
		zephyr,code-partition = &hwdebug_partition;
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
	};
};

/* UART4 is the standalone bring-up console: PC10=TX, PC11=RX, 115200 8N1. */
&uart4 {
	current-speed = <115200>;
	status = "okay";
};

/* UART4, Bank 1 IS25, MCP23017, DS3231, and MAX17048 are fitted for bring-up. */
&usbotg_fs {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&mcp23017 {
	status = "okay";
};

&external_rtc {
	compatible = "maxim,ds3231-mfd";
	status = "okay";

	ef800_hwdebug_rtc: rtc {
		compatible = "maxim,ds3231-rtc";
		isw-gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&fuel_gauge {
	status = "okay";
};

&lpuart1 {
	current-speed = <115200>;
	status = "okay";
};

&usart1 {
	current-speed = <115200>;
	status = "okay";
};

&uart4 {
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	current-speed = <115200>;
	status = "okay";
};

&iwdg {
	status = "okay";
};


/* The storage test owns the QSPI disk and switches it between FAT and MSC. */
&qspi_disk {
	status = "okay";
};

/* The storage test uses the generic NOR driver through the flash-disk API. */
&qspi_nor {
	status = "okay";
	size = <DT_SIZE_M(32)>; /* IS25LP032D: 32 Mbit = 4 MiB */
	qspi-max-frequency = <8000000>;
	cs-high-time = <2>;
	reset-cmd;
	reset-cmd-wait = <10>;
	spi-bus-width = <4>;
	writeoc = "PP_1_1_4";
};

&quadspi {
	ssht-enable;
};

&usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "EF800 USB CDC ACM";
	};
};

/* The debug image owns the parallel T6963 during display bring-up. */
/ {
	zephyr,user {
		keyboard-reset-gpios = <&mcp23017 12 0>;
		data-gpios = <&gpioa 0 0>, <&gpioa 1 0>, <&gpioa 2 0>,
				     <&gpioa 3 0>, <&gpioa 4 0>, <&gpioa 5 0>,
				     <&gpioa 6 0>, <&gpioa 7 0>;
		cd-gpios = <&gpiod 6 0>;
		wr-gpios = <&gpioa 15 0>;
		rd-gpios = <&gpiob 0 0>;
		ce-gpios = <&gpioa 10 0>;
		fs-gpios = <&mcp23017 4 0>;
		reset-gpios = <&mcp23017 5 0>;
		pixels-horizontal = <240>;
		pixels-vertical = <64>;
		font-width = <6>;
		memory-kb = <8>;
	};
};

#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/memory-controller/stm32-fmc-nor-psram.h>
#include <zephyr/dt-bindings/clock/stm32_clock.h>

/* Slow HCLK/FMC to 20 MHz for conservative SRAM timing experiments. */
&pll {
	mul-n = <16>;
	div-r = <4>;
};

&rcc {
	clock-frequency = <DT_FREQ_M(20)>;
};

&pinctrl {
	/* Each FMC pad is separate because STM32 pinctrl accepts one pinmux per node. */
	fmc_pd0: fmc_pd0 { pinmux = <STM32_PINMUX('D', 0, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd1: fmc_pd1 { pinmux = <STM32_PINMUX('D', 1, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd4: fmc_pd4 { pinmux = <STM32_PINMUX('D', 4, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd5: fmc_pd5 { pinmux = <STM32_PINMUX('D', 5, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd7: fmc_pd7 { pinmux = <STM32_PINMUX('D', 7, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd11: fmc_pd11 { pinmux = <STM32_PINMUX('D', 11, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd12: fmc_pd12 { pinmux = <STM32_PINMUX('D', 12, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd13: fmc_pd13 { pinmux = <STM32_PINMUX('D', 13, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd14: fmc_pd14 { pinmux = <STM32_PINMUX('D', 14, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pd15: fmc_pd15 { pinmux = <STM32_PINMUX('D', 15, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf0: fmc_pf0 { pinmux = <STM32_PINMUX('F', 0, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf1: fmc_pf1 { pinmux = <STM32_PINMUX('F', 1, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf2: fmc_pf2 { pinmux = <STM32_PINMUX('F', 2, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf3: fmc_pf3 { pinmux = <STM32_PINMUX('F', 3, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf4: fmc_pf4 { pinmux = <STM32_PINMUX('F', 4, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf5: fmc_pf5 { pinmux = <STM32_PINMUX('F', 5, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf12: fmc_pf12 { pinmux = <STM32_PINMUX('F', 12, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf13: fmc_pf13 { pinmux = <STM32_PINMUX('F', 13, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf14: fmc_pf14 { pinmux = <STM32_PINMUX('F', 14, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pf15: fmc_pf15 { pinmux = <STM32_PINMUX('F', 15, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg0: fmc_pg0 { pinmux = <STM32_PINMUX('G', 0, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg1: fmc_pg1 { pinmux = <STM32_PINMUX('G', 1, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg2: fmc_pg2 { pinmux = <STM32_PINMUX('G', 2, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg3: fmc_pg3 { pinmux = <STM32_PINMUX('G', 3, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg4: fmc_pg4 { pinmux = <STM32_PINMUX('G', 4, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pg5: fmc_pg5 { pinmux = <STM32_PINMUX('G', 5, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pe0: fmc_pe0 { pinmux = <STM32_PINMUX('E', 0, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pe7: fmc_pe7 { pinmux = <STM32_PINMUX('E', 7, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pe8: fmc_pe8 { pinmux = <STM32_PINMUX('E', 8, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pe9: fmc_pe9 { pinmux = <STM32_PINMUX('E', 9, AF12)>; slew-rate = "very-high-speed"; };
	fmc_pe10: fmc_pe10 { pinmux = <STM32_PINMUX('E', 10, AF12)>; };

	usart1_tx_pb6: usart1_tx_pb6 {
		pinmux = <STM32_PINMUX('B', 6, AF7)>;
		bias-pull-up;
		drive-push-pull;
	};

	usart1_rx_pb7: usart1_rx_pb7 {
		pinmux = <STM32_PINMUX('B', 7, AF7)>;
		bias-pull-up;
	};

	usart3_tx_pd8: usart3_tx_pd8 {
		pinmux = <STM32_PINMUX('D', 8, AF7)>;
		bias-pull-up;
		drive-push-pull;
	};

	usart3_rx_pd9: usart3_rx_pd9 {
		pinmux = <STM32_PINMUX('D', 9, AF7)>;
		bias-pull-up;
	};

	lpuart1_tx_pg7: lpuart1_tx_pg7 {
		pinmux = <STM32_PINMUX('G', 7, AF8)>;
		bias-pull-up;
		drive-push-pull;
	};

	lpuart1_rx_pc0: lpuart1_rx_pc0 {
		pinmux = <STM32_PINMUX('C', 0, AF8)>;
		bias-pull-up;
	};

	usb_otg_fs_dm_pa11: usb_otg_fs_dm_pa11 {
		pinmux = <STM32_PINMUX('A', 11, AF10)>;
	};

	usb_otg_fs_dp_pa12: usb_otg_fs_dp_pa12 {
		pinmux = <STM32_PINMUX('A', 12, AF10)>;
	};


	quadspi_clk_pf10: quadspi_clk_pf10 {
		pinmux = <STM32_PINMUX('F', 10, AF3)>;
	};

	quadspi_bk1_ncs_pe11: quadspi_bk1_ncs_pe11 {
		pinmux = <STM32_PINMUX('E', 11, AF10)>;
		bias-pull-up;
	};

	quadspi_bk1_io0_pf8: quadspi_bk1_io0_pf8 {
		pinmux = <STM32_PINMUX('F', 8, AF10)>;
	};

	quadspi_bk1_io1_pf9: quadspi_bk1_io1_pf9 {
		pinmux = <STM32_PINMUX('F', 9, AF10)>;
	};

	quadspi_bk1_io2_pf7: quadspi_bk1_io2_pf7 {
		pinmux = <STM32_PINMUX('F', 7, AF10)>;
		bias-pull-up;
	};

	quadspi_bk1_io3_pf6: quadspi_bk1_io3_pf6 {
		pinmux = <STM32_PINMUX('F', 6, AF10)>;
		bias-pull-up;
	};

};

&fmc {
	pinctrl-0 = <&fmc_pd0 &fmc_pd1 &fmc_pd4 &fmc_pd5 &fmc_pd7
		&fmc_pd11 &fmc_pd12 &fmc_pd13 &fmc_pd14 &fmc_pd15
		&fmc_pf0 &fmc_pf1 &fmc_pf2 &fmc_pf3 &fmc_pf4 &fmc_pf5
		&fmc_pf12 &fmc_pf13 &fmc_pf14 &fmc_pf15
		&fmc_pg0 &fmc_pg1 &fmc_pg2 &fmc_pg3 &fmc_pg4 &fmc_pg5
		&fmc_pe0 &fmc_pe7 &fmc_pe8 &fmc_pe9 &fmc_pe10>;
	pinctrl-names = "default";
	status = "okay";
};

&fmc_sram {
	status = "okay";
};

&sram_bank1 {
	st,control = <STM32_FMC_DATA_ADDRESS_MUX_DISABLE
		STM32_FMC_MEMORY_TYPE_SRAM
		STM32_FMC_NORSRAM_MEM_BUS_WIDTH_8
		STM32_FMC_BURST_ACCESS_MODE_DISABLE
		STM32_FMC_WAIT_SIGNAL_POLARITY_LOW
		STM32_FMC_WAIT_TIMING_BEFORE_WS
		STM32_FMC_WRITE_OPERATION_ENABLE
		STM32_FMC_WAIT_SIGNAL_DISABLE
		STM32_FMC_EXTENDED_MODE_DISABLE
		STM32_FMC_ASYNCHRONOUS_WAIT_DISABLE
		STM32_FMC_WRITE_BURST_DISABLE
		STM32_FMC_CONTINUOUS_CLOCK_SYNC_ONLY
		STM32_FMC_WRITE_FIFO_ENABLE
		STM32_FMC_PAGE_SIZE_NONE>;
	/* Extra-slow experiment: ADDSET=15, ADDHLD=8, DATAST=15 at 20 MHz. */
	st,timing = <15 8 15 0 2 0 STM32_FMC_ACCESS_MODE_A>;
	status = "okay";
};

&quadspi {
	pinctrl-0 = <&quadspi_clk_pf10 &quadspi_bk1_ncs_pe11
			 &quadspi_bk1_io0_pf8 &quadspi_bk1_io1_pf9
				 &quadspi_bk1_io2_pf7 &quadspi_bk1_io3_pf6>;
	pinctrl-names = "default";
	status = "okay";
};

/* This temporary image owns internal flash while it is being debugged. */
&flash0 {
	partitions {
		/delete-node/ partition@0;
		/delete-node/ partition@10000;
		/delete-node/ partition@20000;
		/delete-node/ partition@30000;

		hwdebug_partition: partition@0 {
			label = "hwdebug";
			reg = <0x00000000 0x00100000>;
		};
	};
};
