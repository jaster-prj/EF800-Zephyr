/ {
	chosen {
		zephyr,code-partition = &hwdebug_partition;
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
	};
};

/* UART4 is the standalone bring-up console: PC10=TX, PC11=RX, 115200 8N1. */
&uart4 {
	current-speed = <115200>;
	status = "okay";
};

/* UART4, Bank 1 IS25, and MCP23017 are fitted for bring-up. */
&usbotg_fs {
	status = "disabled";
};

&i2c1 {
	status = "okay";
};

&mcp23017 {
	status = "okay";
};

&external_rtc {
	status = "disabled";
};

&fuel_gauge {
	status = "disabled";
};

&lpuart1 {
	status = "disabled";
};

&usart1 {
	status = "disabled";
};

&uart4 {
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	status = "disabled";
};

&iwdg {
	status = "disabled";
};

/* Never instantiate the QSPI disk or a filesystem in this image. */
&qspi_disk {
	status = "disabled";
};

/*
 * The generic NOR driver is disabled. The application issues explicit
 * read-only transactions so SPI, QSPI, and QPI can be tested independently.
 * reset-cmd is retained as metadata for any future driver use; this image does
 * not erase, program, or change the flash configuration registers.
 */
&qspi_nor {
	status = "disabled";
	size = <DT_SIZE_M(32)>; /* IS25LP032D: 32 Mbit = 4 MiB */
	qspi-max-frequency = <8000000>;
	cs-high-time = <2>;
	reset-cmd;
	reset-cmd-wait = <10>;
	/delete-property/ spi-bus-width;
	/delete-property/ writeoc;
};

&quadspi {
	ssht-enable;
};

&qspi_storage_partition {
	reg = <0x00000000 DT_SIZE_M(4)>;
};

#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

&pinctrl {
	usart1_tx_pb6: usart1_tx_pb6 {
		pinmux = <STM32_PINMUX('B', 6, AF7)>;
		bias-pull-up;
		drive-push-pull;
	};

	usart1_rx_pb7: usart1_rx_pb7 {
		pinmux = <STM32_PINMUX('B', 7, AF7)>;
		bias-pull-up;
	};

	usart3_tx_pd8: usart3_tx_pd8 {
		pinmux = <STM32_PINMUX('D', 8, AF7)>;
		bias-pull-up;
		drive-push-pull;
	};

	usart3_rx_pd9: usart3_rx_pd9 {
		pinmux = <STM32_PINMUX('D', 9, AF7)>;
		bias-pull-up;
	};

	lpuart1_tx_pg7: lpuart1_tx_pg7 {
		pinmux = <STM32_PINMUX('G', 7, AF8)>;
		bias-pull-up;
		drive-push-pull;
	};

	lpuart1_rx_pc0: lpuart1_rx_pc0 {
		pinmux = <STM32_PINMUX('C', 0, AF8)>;
		bias-pull-up;
	};

	i2c1_sda_pg13: i2c1_sda_pg13 {
		pinmux = <STM32_PINMUX('G', 13, AF4)>;
		bias-pull-up;
		drive-open-drain;
		slew-rate = "high-speed";
	};

	i2c1_scl_pg14: i2c1_scl_pg14 {
		pinmux = <STM32_PINMUX('G', 14, AF4)>;
		bias-pull-up;
		drive-open-drain;
		slew-rate = "high-speed";
	};

	usb_otg_fs_dm_pa11: usb_otg_fs_dm_pa11 {
		pinmux = <STM32_PINMUX('A', 11, AF10)>;
	};

	usb_otg_fs_dp_pa12: usb_otg_fs_dp_pa12 {
		pinmux = <STM32_PINMUX('A', 12, AF10)>;
	};

	quadspi_clk_pf10: quadspi_clk_pf10 {
		pinmux = <STM32_PINMUX('F', 10, AF3)>;
	};

	quadspi_bk1_ncs_pe11: quadspi_bk1_ncs_pe11 {
		pinmux = <STM32_PINMUX('E', 11, AF10)>;
		bias-pull-up;
	};

	quadspi_bk1_io0_pf8: quadspi_bk1_io0_pf8 {
		pinmux = <STM32_PINMUX('F', 8, AF10)>;
	};

	quadspi_bk1_io1_pf9: quadspi_bk1_io1_pf9 {
		pinmux = <STM32_PINMUX('F', 9, AF10)>;
	};

	quadspi_bk1_io2_pf7: quadspi_bk1_io2_pf7 {
		pinmux = <STM32_PINMUX('F', 7, AF10)>;
		bias-pull-up;
	};

	quadspi_bk1_io3_pf6: quadspi_bk1_io3_pf6 {
		pinmux = <STM32_PINMUX('F', 6, AF10)>;
		bias-pull-up;
	};

};

&quadspi {
	pinctrl-0 = <&quadspi_clk_pf10 &quadspi_bk1_ncs_pe11
			 &quadspi_bk1_io0_pf8 &quadspi_bk1_io1_pf9
				 &quadspi_bk1_io2_pf7 &quadspi_bk1_io3_pf6>;
	pinctrl-names = "default";
	status = "okay";
};

/* This temporary image owns internal flash while it is being debugged. */
&flash0 {
	partitions {
		/delete-node/ partition@0;
		/delete-node/ partition@10000;
		/delete-node/ partition@20000;
		/delete-node/ partition@30000;

		hwdebug_partition: partition@0 {
			label = "hwdebug";
			reg = <0x00000000 0x00100000>;
		};
	};
};
