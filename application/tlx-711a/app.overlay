#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		cdc-baudrate = <256000>;
		/* Nucleo-WB55RG Arduino header mapping. */
		data-gpios = <&gpioa 3 0>,  /* D0 */
				     <&gpioa 2 0>,  /* D1 */
				     <&gpioc 6 0>,  /* D2 */
				     <&gpioa 10 0>, /* D3 */
				     <&gpioc 10 0>, /* D4 */
				     <&gpioa 15 0>, /* D5 */
				     <&gpioa 8 0>,  /* D6 */
				     <&gpioc 13 0>; /* D7 */
		wr-gpios = <&gpioc 12 0>; /* D8 */
		rd-gpios = <&gpioa 9 0>;  /* D9 */
		ce-gpios = <&gpioa 4 0>;  /* D10 */
		cd-gpios = <&gpioa 7 0>;  /* D11 */
		reset-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>; /* D12 */
		fs-gpios = <&gpioa 5 0>;   /* D13 */
		pixels-horizontal = <240>;
		pixels-vertical = <64>;
	};

	chosen {
	};
};

/* Native USB is the transport because D10/PB6 is occupied by LCD /CE. */
&usb {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
		status = "okay";
	};
};

/* SPI1 claims Arduino D10, D11, and D13, which are LCD /CE, C/D, and FS. */
&spi1 {
	status = "disabled";
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};
