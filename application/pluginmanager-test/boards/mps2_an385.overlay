/ {
    aliases {
        plugin-uart = &uart1;
    };

    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };

    plugin_disk: plugin_disk {
        compatible = "zephyr,ram-disk";
        disk-name = "PM";
        sector-size = <4096>;
        sector-count = <128>;
        status = "okay";
    };
};

&uart0 {
    current-speed = <115200>;
    status = "okay";
};

&uart1 {
    current-speed = <9600>;
    status = "okay";
};
