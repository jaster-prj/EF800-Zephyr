/dts-v1/;
#include <st/l4/stm32l496Xg.dtsi>
#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "Jaster EF800";
	compatible = "jaster,ef800";

	/*
	 * PB8/TIM4_CH3 is wired to the contrast filter only on modified units.
	 * The application applies this pinctrl state only for LCDCONTR1; JP15
	 * remains open and the flying wire is attached on the MCU-side pad.
	 */
	lcd_contrast: lcd-contrast {
		compatible = "jaster,ef800-lcd-contrast";
		gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&tim4_ch3_pb8>;
		pinctrl-names = "default";
	};

	chosen {
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		watchdog0 = &iwdg;
	};

	zephyr,user {
		/* JP7 links this active-low request to keyboard PB12. */
		keyboard-updater-request-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
	};

	leds {
		compatible = "gpio-leds";

		status_led: status_led {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
			label = "EF800 status";
		};
	};

	/* IS25LP032D-JTLE-TR: 32 Mbit / 4 MiB at 3.3 V. */
	qspi_disk: qspi_disk {
		compatible = "zephyr,flash-disk";
		partition = <&qspi_storage_partition>;
		disk-name = "DATA";
		sector-size = <512>;
		cache-size = <4096>;
		status = "okay";
	};

	qspi_configuration_disk: qspi_configuration_disk {
		compatible = "zephyr,flash-disk";
		partition = <&qspi_configuration_partition>;
		disk-name = "EF800";
		sector-size = <512>;
		cache-size = <4096>;
		status = "okay";
	};

};

/* STM32L496 FMC is not declared by the upstream L4 SoC DTSI. */

/ {
	fmc: memory-controller@a0000000 {
		compatible = "st,stm32-fmc";
		reg = <0xa0000000 0x400>;
		clocks = <&rcc STM32_CLOCK(AHB3, 0)>;
		status = "disabled";

		fmc_sram: sram {
			compatible = "st,stm32-fmc-nor-psram";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			sram_bank1: sram@0 {
				reg = <0>;
				status = "disabled";
			};
		};
	};
};

&usbotg_fs {
		pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
		pinctrl-names = "default";
		status = "okay";
};

&clk_hse {
		clock-frequency = <DT_FREQ_M(25)>;
		status = "okay";
};

&clk_hsi48 {
		status = "okay";
};

&clk_hsi {
		status = "okay";
};

&pll {
		div-m = <5>;
		mul-n = <32>;
		div-p = <2>;
		div-q = <2>;
		div-r = <2>;
		clocks = <&clk_hse>;
		status = "okay";
};

&rcc {
		clocks = <&pll>;
		clock-frequency = <DT_FREQ_M(80)>;
		ahb-prescaler = <1>;
		apb1-prescaler = <1>;
		apb2-prescaler = <1>;
};

&iwdg {
		status = "okay";
};

&i2c1 {
		pinctrl-0 = <&i2c1_sda_pg13 &i2c1_scl_pg14>;
		pinctrl-names = "default";
		clock-frequency = <I2C_BITRATE_FAST>;
		status = "okay";

		mcp23017: gpio@24 {
			compatible = "microchip,mcp23017";
			reg = <0x24>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "okay";
		};

		external_rtc: rtc@68 {
			compatible = "maxim,ds3231";
			reg = <0x68>;
			status = "okay";
		};

		fuel_gauge: fuel-gauge@36 {
			compatible = "maxim,max17048";
			reg = <0x36>;
			status = "okay";
		};
};

&pinctrl {
	tim4_ch3_pb8: tim4_ch3_pb8 {
		pinmux = <STM32_PINMUX('B', 8, AF2)>;
		bias-disable;
		drive-push-pull;
	};

	i2c1_sda_pg13: i2c1_sda_pg13 {
		pinmux = <STM32_PINMUX('G', 13, AF4)>;
		bias-pull-up;
		drive-open-drain;
		slew-rate = "high-speed";
	};

	i2c1_scl_pg14: i2c1_scl_pg14 {
		pinmux = <STM32_PINMUX('G', 14, AF4)>;
		bias-pull-up;
		drive-open-drain;
		slew-rate = "high-speed";
	};

	uart4_tx_pc10: uart4_tx_pc10 {
		pinmux = <STM32_PINMUX('C', 10, AF8)>;
		bias-pull-up;
		drive-push-pull;
	};

	uart4_rx_pc11: uart4_rx_pc11 {
		pinmux = <STM32_PINMUX('C', 11, AF8)>;
		bias-pull-up;
	};
};

&lpuart1 {
		pinctrl-0 = <&lpuart1_tx_pg7 &lpuart1_rx_pc0>;
		pinctrl-names = "default";
		tx-rx-swap;
		current-speed = <115200>;
		status = "okay";
};

&usart1 {
		pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
		pinctrl-names = "default";
		current-speed = <115200>;
		status = "okay";
};

&usart3 {
		pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
		pinctrl-names = "default";
		current-speed = <115200>;
		status = "okay";
};

/* UART4 is the normal EF800 development console and Port 1 serial connection. */
&uart4 {
	pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&quadspi {
		/* These symbols are provided by the STM32L4 pinctrl include when available. */
		pinctrl-0 = <&quadspi_clk_pf10 &quadspi_bk1_ncs_pe11
				 &quadspi_bk1_io0_pf8 &quadspi_bk1_io1_pf9
				 &quadspi_bk1_io2_pf7 &quadspi_bk1_io3_pf6>;
		pinctrl-names = "default";
		ssht-enable;
		status = "okay";

		qspi_nor: qspi-nor-flash@0 {
			compatible = "st,stm32-qspi-nor";
			reg = <0>;
			size = <DT_SIZE_M(32)>;
			qspi-max-frequency = <8000000>;
			cs-high-time = <2>;
			reset-cmd;
			reset-cmd-wait = <10>;
			spi-bus-width = <4>;
			writeoc = "PP_1_1_4";
			status = "okay";

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				/* Keep the existing metadata_partition label for the shared
				 * NVS adapter; it now points at external QSPI boot-state NVS. */
				metadata_partition: qspi_bootstate_partition: partition@0 {
					label = "qspi-boot-state";
					reg = <0x00000000 0x00008000>;
				};

				qspi_configuration_partition: partition@8000 {
					label = "qspi-configuration";
					reg = <0x00008000 0x000F8000>;
				};

				/* Keep the existing disk label for consumers; it now denotes
				 * only the independently owned shared-data volume. */
				qspi_storage_partition: partition@100000 {
					label = "qspi-shared-data";
					reg = <0x00100000 0x00300000>;
				};
			};
		};
};

&flash0 {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boot_partition: partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00010000>;
			};

			backup_partition: partition@10000 {
				label = "backup";
				reg = <0x00010000 0x00020000>;
			};

			main_partition: partition@30000 {
				label = "main";
				reg = <0x00030000 0x000d0000>;
			};
		};
};
