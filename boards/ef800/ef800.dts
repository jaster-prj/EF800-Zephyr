/dts-v1/;
#include <st/l4/stm32l496Xg.dtsi>
#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "Jaster EF800";
	compatible = "jaster,ef800";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		watchdog0 = &iwdg;
	};

	leds {
		compatible = "gpio-leds";

		status_led: status_led {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
			label = "EF800 status";
		};
	};

	/* The fitted part must be verified before production use. */
	qspi_disk: qspi_disk {
		compatible = "zephyr,flash-disk";
		partition = <&qspi_storage_partition>;
		disk-name = "EF800";
		sector-size = <512>;
		cache-size = <4096>;
		status = "okay";
	};

};

&usbotg_fs {
		pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
		pinctrl-names = "default";
		status = "okay";
};

&clk_hse {
		clock-frequency = <DT_FREQ_M(25)>;
		status = "okay";
};

&clk_hsi48 {
		status = "okay";
};

&clk_hsi {
		status = "okay";
};

&pll {
		div-m = <5>;
		mul-n = <32>;
		div-p = <2>;
		div-q = <2>;
		div-r = <2>;
		clocks = <&clk_hse>;
		status = "okay";
};

&rcc {
		clocks = <&pll>;
		clock-frequency = <DT_FREQ_M(80)>;
		ahb-prescaler = <1>;
		apb1-prescaler = <1>;
		apb2-prescaler = <1>;
};

&iwdg {
		status = "okay";
};

&i2c1 {
		pinctrl-0 = <&i2c1_sda_pg13 &i2c1_scl_pg14>;
		pinctrl-names = "default";
		clock-frequency = <I2C_BITRATE_FAST>;
		status = "okay";

		mcp23017: gpio@48 {
			compatible = "microchip,mcp23017";
			reg = <0x48>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "okay";
		};

		external_rtc: rtc@68 {
			compatible = "maxim,ds3231";
			reg = <0x68>;
			status = "okay";
		};

		fuel_gauge: fuel-gauge@36 {
			compatible = "maxim,max17043";
			reg = <0x36>;
			status = "okay";
		};
};

&lpuart1 {
		pinctrl-0 = <&lpuart1_tx_pg7 &lpuart1_rx_pc0>;
		pinctrl-names = "default";
		current-speed = <9600>;
		status = "okay";
};

&usart1 {
		pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
		pinctrl-names = "default";
		current-speed = <115200>;
		status = "okay";
};

&usart3 {
		pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
		pinctrl-names = "default";
		current-speed = <115200>;
		status = "okay";
};

&quadspi {
		/* These symbols are provided by the STM32L4 pinctrl include when available. */
		pinctrl-0 = <&quadspi_clk_pf10 &quadspi_bk1_ncs_pe11
				 &quadspi_bk1_io0_pf8 &quadspi_bk1_io1_pf9
				 &quadspi_bk1_io2_pf7 &quadspi_bk1_io3_pf6>;
		pinctrl-names = "default";
		status = "okay";

		qspi_nor: qspi-nor-flash@0 {
			compatible = "st,stm32-qspi-nor";
			reg = <0>;
			/* Default placeholder: verify the fitted NOR device. */
			size = <DT_SIZE_M(8)>;
			qspi-max-frequency = <8000000>;
			cs-high-time = <2>;
			spi-bus-width = <4>;
			writeoc = "PP_1_1_4";
			status = "okay";

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				qspi_storage_partition: partition@0 {
					label = "qspi-storage";
					reg = <0x00000000 DT_SIZE_M(8)>;
				};
			};
		};
};

&flash0 {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boot_partition: partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00010000>;
			};

			backup_partition: partition@10000 {
				label = "backup";
				reg = <0x00010000 0x00010000>;
			};

			metadata_partition: partition@20000 {
				label = "boot-metadata";
				reg = <0x00020000 0x00010000>;
			};

			main_partition: partition@30000 {
				label = "main";
				reg = <0x00030000 0x000d0000>;
			};
		};
};
