/delete-node/ &storage_partition;

/ {
	uhc_vrt0: uhc_vrt0 {
		compatible = "zephyr,uhc-virtual";
		status = "okay";

		usbotg_fs: usbotg_fs {
			compatible = "zephyr,udc-virtual";
			num-bidir-endpoints = <8>;
			maximum-speed = "full-speed";
			status = "okay";

			cdc_acm_uart0: cdc_acm_uart0 {
				compatible = "zephyr,cdc-acm-uart";
				rx-fifo-size = <256>;
				tx-fifo-size = <256>;
				status = "okay";
			};
		};

	qspi_test_data_disk: qspi_test_data_disk {
			compatible = "zephyr,flash-disk";
			partition = <&qspi_storage_partition>;
			disk-name = "DATA";
			sector-size = <512>;
			cache-size = <4096>;
			status = "okay";
		};
	};

	usart1: usart1 {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <256>;
		tx-fifo-size = <256>;
		status = "okay";
	};

	usart3: usart3 {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <256>;
		tx-fifo-size = <256>;
		status = "okay";
	};

	uart4: uart4 {
		compatible = "zephyr,native-pty-uart";
		current-speed = <115200>;
		status = "okay";
	};
};

&flash0 {
	partitions {
		qspi_bootstate_partition: partition@fc000 {
			label = "qspi-boot-state-test";
			reg = <0x000fc000 0x00008000>;
		};

		qspi_configuration_partition: partition@104000 {
			label = "qspi-configuration-test";
			reg = <0x00104000 0x00018000>;
		};

		qspi_storage_partition: partition@11c000 {
			label = "qspi-shared-data-test";
			reg = <0x0011c000 0x00060000>;
		};
	};
};
