/delete-node/ &storage_partition;

/ {
	qspi_data_test_disk: qspi_data_test_disk {
		compatible = "zephyr,flash-disk";
		partition = <&qspi_storage_partition>;
		disk-name = "DATA";
		sector-size = <512>;
		cache-size = <4096>;
		status = "okay";
	};

	qspi_configuration_test_disk: qspi_configuration_test_disk {
		compatible = "zephyr,flash-disk";
		partition = <&qspi_configuration_partition>;
		disk-name = "EF800";
		sector-size = <512>;
		cache-size = <4096>;
		status = "okay";
	};
};

&flash0 {
	partitions {
		metadata_partition: qspi_bootstate_partition: partition@fc000 {
			compatible = "zephyr,mapped-partition";
			label = "qspi-boot-state-test";
			reg = <0x000fc000 0x00008000>;
		};

		qspi_configuration_partition: partition@104000 {
			compatible = "zephyr,mapped-partition";
			label = "qspi-configuration-test";
			reg = <0x00104000 0x00018000>;
		};

		qspi_storage_partition: partition@11c000 {
			compatible = "zephyr,mapped-partition";
			label = "qspi-shared-data-test";
			reg = <0x0011c000 0x00060000>;
		};
	};
};
